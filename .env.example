# IMPORTANT:
# - In Vercel, add values without quotes.
# - Keep DEMO_MODE=true while database is not configured.

# Core
DATABASE_URL=postgresql://ticketflow:ticketflow@localhost:5432/ticketflow?schema=public
NEXTAUTH_URL=http://decizyon.com.br
NEXTAUTH_SECRET=change-me

# Mode
DEMO_MODE=true

# SMTP (required for lead/contact emails)
SMTP_HOST=smtps.uhserver.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@decizyon.com.br
SMTP_PASS=change-me
SMTP_FROM=Decizyon <contato@decizyon.com.br>

# Feature flags
STRIPE_ENABLED=false
UPLOADS_ENABLED=false

# Optional integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TEAMS_WEBHOOK_URL=
RESEND_API_KEY=
RESEND_FROM=Decizyon <contato@decizyon.com.br>
